cali = cali.to_crs(3116)  # CRS métrico para Colombia

# Crear GeoDataFrame de puntos
puntos = gpd.GeoDataFrame(
    df, 
    geometry=gpd.points_from_xy(df[lon_col], df[lat_col]), 
    crs="EPSG:4326"
)
puntos = puntos.to_crs(3116)

# Filtrar puntos dentro de Cali
try:
    area_cali = cali.geometry.union_all()
except AttributeError:
    area_cali = cali.geometry.unary_union

puntos = puntos[puntos.within(area_cali)]
print(f"Puntos dentro de Cali: {len(puntos)}")

if len(puntos) == 0:
    raise SystemExit("No hay puntos dentro de Cali después del filtrado.")

n_eventos_total = len(puntos)

# -------------------------------------------------
# 3️⃣ Función de cálculo de métricas
# -------------------------------------------------
def calcular_metricas_completas(puntos_gdf, cali_gdf, h_m):
    """
    Calcula todas las métricas relevantes para evaluación
    """
    minx, miny, maxx, maxy = cali_gdf.total_bounds
    
    # Crear grilla métrica
    x_coords = np.arange(minx, maxx + h_m, h_m)
    y_coords = np.arange(miny, maxy + h_m, h_m)
    
    celdas = []
    for x in x_coords[:-1]:
        for y in y_coords[:-1]:
            celda = box(x, y, x + h_m, y + h_m)
            if celda.intersects(area_cali):
                celdas.append(celda)
    
    if len(celdas) == 0:
        return None
    
    grid = gpd.GeoDataFrame(geometry=celdas, crs=cali_gdf.crs)
    
    # Contar puntos por celda
    join = gpd.sjoin(puntos_gdf, grid, how="inner", predicate="within")
    conteo = join.groupby("index_right").size()
    
    # Crear array completo con ceros para celdas vacías
    conteo_completo = np.zeros(len(grid))
    conteo_completo[conteo.index] = conteo.values
    
    # Calcular métricas básicas
    n_celdas = len(grid)
    eventos_por_celda = n_eventos_total / n_celdas
    celdas_vacias = (conteo_completo == 0).sum()
    pct_vacias = celdas_vacias / n_celdas * 100
    
    # Densidad y estadísticas
    densidad = conteo_completo / (h_m**2 / 1e6)  # eventos por km²
    varianza = np.var(densidad)
    std_dev = np.std(densidad)
    mean_densidad = np.mean(densidad)
    cv = std_dev / (mean_densidad + 1e-6)  # Coeficiente de variación
    
    # Estadísticas de celdas con datos
    celdas_con_datos = conteo_completo[conteo_completo > 0]
    if len(celdas_con_datos) > 0:
        min_eventos = celdas_con_datos.min()
        max_eventos = celdas_con_datos.max()
        mediana_eventos = np.median(celdas_con_datos)
        q25 = np.percentile(celdas_con_datos, 25)
        q75 = np.percentile(celdas_con_datos, 75)
        iqr = q75 - q25
    else:
        min_eventos = max_eventos = mediana_eventos = q25 = q75 = iqr = 0
    
    # Índice de Moran (autocorrelación espacial simplificada)
    # Solo como aproximación rápida
    moran_approx = cv if cv < 3 else 3  # Limitado para estabilidad
    
    return {
        'n_celdas': n_celdas,
        'eventos_por_celda': eventos_por_celda,
        'pct_vacias': pct_vacias,
        'celdas_vacias': celdas_vacias,
        'varianza': varianza,
        'std_dev': std_dev,
        'cv': cv,
        'min_eventos': min_eventos,
        'max_eventos': max_eventos,
        'mediana_eventos': mediana_eventos,
        'q25': q25,
        'q75': q75,
        'iqr': iqr,
        'moran_approx': moran_approx
    }

# Funciones objetivo (scikit-optimize MINIMIZA)
# -------------------------------------------------
historico_evaluaciones = []
contador_evaluaciones = [0]

def funcion_objetivo_compuesta(h):
    """
    Función objetivo compuesta que MINIMIZAR
    (scikit-optimize siempre minimiza, a diferencia de bayes_opt)
    
    Menor valor = mejor solución
    """
    h = float(h)
    contador_evaluaciones[0] += 1
    
    metricas = calcular_metricas_completas(puntos, cali, h)
    
    if metricas is None:
        return 1000.0  # Penalización alta si falla
    
    # Extraer métricas
    eventos_x_celda = metricas['eventos_por_celda']
    pct_vacias = metricas['pct_vacias']
    n_celdas = metricas['n_celdas']
    cv = metricas['cv']
    varianza = metricas['varianza']
    
    # === COMPONENTE 1: Desviación de eventos óptimos por celda ===
    # Objetivo: 8-12 eventos por celda
    objetivo_eventos = 10
    if eventos_x_celda < 5:
        penalizacion_eventos = (5 - eventos_x_celda) ** 2 * 10  # Penalización fuerte
    elif eventos_x_celda > 20:
        penalizacion_eventos = (eventos_x_celda - 20) ** 2 * 0.5
    else:
        penalizacion_eventos = abs(eventos_x_celda - objetivo_eventos) ** 2
    
    # === COMPONENTE 2: Penalización por celdas vacías ===
    if pct_vacias < 15:
        penalizacion_vacias = pct_vacias * 0.5
    elif pct_vacias < 30:
        penalizacion_vacias = pct_vacias * 2
    else:
        penalizacion_vacias = pct_vacias * 5  # Penalización muy fuerte
    
    # === COMPONENTE 3: Costo computacional ===
    # Preferir entre 100-1000 celdas
    if n_celdas < 50:
        penalizacion_celdas = (50 - n_celdas) * 2
    elif n_celdas > 2000:
        penalizacion_celdas = (n_celdas - 2000) * 0.1
    else:
        penalizacion_celdas = 0
    
    # === COMPONENTE 4: Capacidad de detectar hotspots ===
    # CV entre 0.8 y 2.5 es ideal
    if cv < 0.5:
        penalizacion_cv = (0.5 - cv) ** 2 * 20  # Muy uniforme
    elif cv > 3.0:
        penalizacion_cv = (cv - 3.0) ** 2 * 10  # Muy disperso
    else:
        penalizacion_cv = 0
    
    # === SCORE FINAL (suma ponderada de penalizaciones) ===
    score_total = (
        penalizacion_eventos * 2.0 +     # Peso más alto
        penalizacion_vacias * 1.5 +
        penalizacion_celdas * 0.3 +
        penalizacion_cv * 0.8
    )
    
    # Calcular score de calidad para visualización (0-100)
    score_calidad = max(0, 100 - score_total * 2)
    
    # Guardar para análisis
    historico_evaluaciones.append({
        'iteracion': contador_evaluaciones[0],
        'h': h,
        'score_optimizacion': score_total,  # Lo que minimizamos
        'score_calidad': score_calidad,     # Para visualización
        'eventos_x_celda': eventos_x_celda,
        'pct_vacias': pct_vacias,
        'n_celdas': n_celdas,
        'cv': cv,
        'varianza': varianza
    })
    
    if contador_evaluaciones[0] % 5 == 0:
        print(f"  Evaluación {contador_evaluaciones[0]:3d}: h={h:7.1f}m | "
              f"score={score_total:7.2f} | eventos/celda={eventos_x_celda:5.2f}")
    
    return score_total

# -------------------------------------------------
# 5️⃣ Definir espacio de búsqueda
# -------------------------------------------------
space = [Real(50.0, 2000.0, name='h')]  # Tamaño de celda en metros

@use_named_args(space)
def objetivo_wrapper(h):
    """Wrapper para compatibilidad con @use_named_args"""
    return funcion_objetivo_compuesta(h)

